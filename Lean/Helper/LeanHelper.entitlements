<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Sandbox inheritance: the helper MUST use exactly these two keys and
    no others, or the system aborts it at spawn. It inherits the main app's
    sandbox wholesale (network, files, JIT, Mach), which is what lets CEF
    subprocess IPC work. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.inherit</key>
    <true/>
</dict>
</plist>
