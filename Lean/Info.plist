<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>Lean</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIconFile</key>
    <string>lean</string>
    <key>CFBundleIconName</key>
    <string>lean</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>LSMinimumSystemVersion</key>
    <string>$(MACOSX_DEPLOYMENT_TARGET)</string>
    <!-- Owning http and https is what lets macOS offer Lean as the default
         browser, and what sends a link clicked in Mail here. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>Web address</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>http</string>
                <string>https</string>
            </array>
        </dict>
    </array>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Web page</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.html</string>
                <string>com.apple.web-internet-location</string>
            </array>
        </dict>
    </array>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- A web browser must load whatever address the user types, including
         plain-http boxes on the LAN, dev servers, and captive portals.
         macOS blocks cleartext http to non-loopback hosts by default
         (localhost alone is exempt), so without this every http-only host
         fails at the OS level no matter what the tab requests. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <key>NSCameraUsageDescription</key>
    <string>Lean needs camera access for video calls (e.g. Google Meet) when you choose to allow it per site.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Lean needs microphone access for calls and voice input when you choose to allow it per site.</string>
    <!-- Sparkle update authentication (Ed25519). The per-architecture feed
         URL is provided at runtime by AppUpdater; see Lean/AppUpdater.swift. -->
    <key>SUPublicEDKey</key>
    <string>ZTkTwsY6NBoOXXzftDHmOdLyCnHzBQThSwAfJX/2PM8=</string>
    <key>SUEnableInstallerLauncherService</key>
    <true/>
</dict>
</plist>
