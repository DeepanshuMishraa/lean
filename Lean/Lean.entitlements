<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Sparkle updater XPC services (sandboxed app support) -->
    <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
    <array>
        <string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
        <string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
        <!-- Native picture in picture: WebKit presents the system window through this service. Without the
             lookup the sandbox refuses it, the page believes it is in picture-in-picture, and no window
             ever appears. -->
        <string>com.apple.PIPAgent</string>
    </array>
    <key>com.apple.security.temporary-exception.shared-preference.read-write</key>
    <array>
        <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    </array>
    <!-- Local pages: a sandboxed app that is handed index.html can read only
         that one file, so the stylesheets, scripts and images beside it fail
         to load. Read-only access to the home folder lets a page's own
         folder be granted to the web view (see LeanTab.load). -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
    <array>
        <string>/</string>
    </array>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
    <key>com.apple.security.print</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Ad-hoc signed (no Team ID): dyld derives each binary's team from its
    cdhash, so the app and embedded Sparkle can never match teams under the
    hardened runtime's library validation. Disable it or every Release build
    aborts at launch with "different Team IDs". Safe: distribution is ad-hoc. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
